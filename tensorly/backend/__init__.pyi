"""Type stubs for the dynamically dispatched backend functions.

The functions implemented by each backend are only known at runtime, so type
checkers cannot see them. This stub declares the ones following the Python array
API standard (https://data-apis.org/array-api/) with the exact signatures of the
standard, which lets a type checker such as mypy flag calls that deviate from it.
The remaining functions are declared with a permissive signature.
"""

from typing import Any, Sequence, TypeAlias

Array: TypeAlias = Any

# ---- Functions following the array API standard ----------------------------
# Positional-only (/) and keyword-only (*) markers follow the standard, so that
# a type checker flags calls that are not valid in the standard.

def abs(x: Array, /) -> Array: ...
def sqrt(x: Array, /) -> Array: ...
def exp(x: Array, /) -> Array: ...
def log(x: Array, /) -> Array: ...
def log2(x: Array, /) -> Array: ...
def sin(x: Array, /) -> Array: ...
def cos(x: Array, /) -> Array: ...
def tan(x: Array, /) -> Array: ...
def sinh(x: Array, /) -> Array: ...
def cosh(x: Array, /) -> Array: ...
def tanh(x: Array, /) -> Array: ...
def asin(x: Array, /) -> Array: ...
def acos(x: Array, /) -> Array: ...
def atan(x: Array, /) -> Array: ...
def asinh(x: Array, /) -> Array: ...
def acosh(x: Array, /) -> Array: ...
def atanh(x: Array, /) -> Array: ...
def sign(x: Array, /) -> Array: ...
def real(x: Array, /) -> Array: ...
def conj(x: Array, /) -> Array: ...
def maximum(x1: Array | float, x2: Array | float, /) -> Array: ...
def minimum(x1: Array | float, x2: Array | float, /) -> Array: ...
def matmul(x1: Array, x2: Array, /) -> Array: ...
def tensordot(
    x1: Array, x2: Array, /, *, axes: int | tuple[Sequence[int], Sequence[int]] = 2
) -> Array: ...
def trace(x: Array, /, *, offset: int = 0) -> Array: ...
def concat(arrays: Sequence[Array], /, *, axis: int | None = 0) -> Array: ...
def stack(arrays: Sequence[Array], /, *, axis: int = 0) -> Array: ...
def permute_dims(x: Array, /, axes: tuple[int, ...]) -> Array: ...
def moveaxis(
    x: Array, source: int | Sequence[int], destination: int | Sequence[int], /
) -> Array: ...
def reshape(
    x: Array, /, shape: tuple[int, ...], *, copy: bool | None = None
) -> Array: ...
def where(condition: Array, x1: Array | float, x2: Array | float, /) -> Array: ...
def clip(
    x: Array, /, min: Array | float | None = None, max: Array | float | None = None
) -> Array: ...
def sort(
    x: Array, /, *, axis: int = -1, descending: bool = False, stable: bool = True
) -> Array: ...
def argsort(
    x: Array, /, *, axis: int = -1, descending: bool = False, stable: bool = True
) -> Array: ...
def eye(
    n_rows: int, n_cols: int | None = None, /, *, k: int = 0, dtype: Any = None
) -> Array: ...
def sum(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def prod(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def mean(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def max(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def min(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def all(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
) -> Array: ...
def any(
    x: Array, /, *, axis: int | tuple[int, ...] | None = None, keepdims: bool = False
